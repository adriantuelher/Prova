<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/main"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/pizza_background"
android:orientation="vertical">

<!-- Cabeçalho com saudação personalizada -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pizza_yellow_accent"
    android:padding="20dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/txtBoasVindas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="BEM-VINDO, CLIENTE"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/btnSair"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="Sair"
        android:src="@android:drawable/ic_lock_power_off"
        app:tint="@android:color/white" />
</LinearLayout>

<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/recyclerPizzas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingTop="8dp"
    android:paddingBottom="16dp" />

</LinearLayout>