<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/pizza_background"
android:gravity="center"
android:orientation="vertical"
android:padding="32dp">

<ImageView
    android:id="@+id/imgLogo"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:layout_marginBottom="24dp"
    android:contentDescription="Logotipo da Pizzaria"
    android:src="@drawable/ic_pizza_slice" />

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="DIGITE SEU NOME"
    android:textColor="@color/pizza_text_primary"
    android:textSize="22sp"
    android:textStyle="bold"
    android:layout_marginBottom="20dp" />

<com.google.android.material.textfield.TextInputLayout
    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="Nome"
    app:boxStrokeColor="@color/pizza_red_primary"
    app:hintTextColor="@color/pizza_red_primary">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/edtNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPersonName"
        android:maxLines="1" />
</com.google.android.material.textfield.TextInputLayout>

<com.google.android.material.button.MaterialButton
    android:id="@+id/btnEntrar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginTop="24dp"
    android:text="ENTRAR"
    android:textColor="@android:color/white"
    android:textSize="16sp"
    android:textStyle="bold"
    app:backgroundTint="@color/pizza_red_primary"
    app:cornerRadius="12dp" />

</LinearLayout>