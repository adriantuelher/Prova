<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pizza_background"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imgDetalhePizza"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:scaleType="centerCrop"
        android:src="@drawable/pizza_pepperoni" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtDetalheNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome da Pizza"
            android:textColor="@color/pizza_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDetalhePreco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="R$ 39,90"
            android:textColor="@color/pizza_price_green"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ingredientes:"
            android:textColor="@color/pizza_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDetalheIngredientes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mussarela, molho artesanal, fatias de pepperoni..."
            android:textColor="@color/pizza_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtTempoPreparo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="⏱ Tempo estimado: 25-35 min"
            android:textColor="@color/pizza_yellow_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Botões de Ação na base -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoltar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="VOLTAR"
            android:textColor="@color/pizza_red_primary"
            app:strokeColor="@color/pizza_red_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarPedido"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="2"
            android:text="CONFIRMAR PEDIDO"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/pizza_red_primary" />
    </LinearLayout>
</LinearLayout>